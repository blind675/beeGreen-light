{
  "name": "beegreen-iot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "postinstall": "npm run db:generate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}