generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  publicId    String   @unique
  name        String
  acceptImage Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sensors     Sensor[]
  records     Record[]
  images      Image[]
}

model Sensor {
  id        String  @id @default(cuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Record {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deviceId   String
  sensorName String
  value      Float
  timestamp  DateTime @default(now())

  @@index([projectId, sensorName, timestamp])
  @@index([deviceId])
}

model Image {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  data      String
  mime      String   @default("image/jpeg")
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
